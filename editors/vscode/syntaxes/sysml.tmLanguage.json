{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Written by `cargo xtask vscode-grammar` from ortho's keyword list. Do not edit by hand.",
  "name": "SysML v2",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#names"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//\\*",
          "end": "\\*/",
          "name": "comment.block.note.sysml"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.sysml"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.documentation.sysml"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "storage.type.sysml"
            },
            "2": {
              "name": "punctuation.definition.short-name.sysml"
            },
            "3": {
              "name": "punctuation.definition.short-name.sysml"
            },
            "4": {
              "name": "entity.name.type.sysml"
            }
          },
          "comment": "The name a definition declares, as a class's: part def Motor.",
          "match": "\\b(def)\\s+(?:(<)\\s*(?:[A-Za-z_][A-Za-z0-9_]*|'(?:[^'\\\\\\r\\n]|\\\\.)*')\\s*(>)\\s*)?((?:[A-Za-z_][A-Za-z0-9_]*|'(?:[^'\\\\\\r\\n]|\\\\.)*'))"
        },
        {
          "captures": {
            "1": {
              "name": "storage.type.sysml"
            },
            "2": {
              "name": "punctuation.definition.short-name.sysml"
            },
            "3": {
              "name": "punctuation.definition.short-name.sysml"
            },
            "4": {
              "name": "entity.name.namespace.sysml"
            }
          },
          "comment": "The name a package declares: package Power.",
          "match": "\\b(package)\\s+(?:(<)\\s*(?:[A-Za-z_][A-Za-z0-9_]*|'(?:[^'\\\\\\r\\n]|\\\\.)*')\\s*(>)\\s*)?((?:[A-Za-z_][A-Za-z0-9_]*|'(?:[^'\\\\\\r\\n]|\\\\.)*'))"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:true|false|null)\\b",
          "name": "constant.language.sysml"
        },
        {
          "match": "\\b(?:and|or|xor|not|implies)\\b",
          "name": "keyword.operator.logical.sysml"
        },
        {
          "match": "\\b(?:specializes|subsets|redefines|references|typed|defined|by|of|to|from|about|via|crosses|hastype|istype|as|meta|all|new)\\b",
          "name": "keyword.operator.word.sysml"
        },
        {
          "match": "\\b(?:private|protected|public|abstract|variation|variant|individual|ordered|nonunique|derived|constant|in|out|inout|end|ref|default|standard|library|parallel)\\b",
          "name": "storage.modifier.sysml"
        },
        {
          "match": "\\b(?:import|expose|filter|render|accept|send|assign|do|entry|exit|if|else|then|first|loop|while|until|for|fork|join|merge|decide|terminate|return|after|at|when)\\b",
          "name": "keyword.control.sysml"
        },
        {
          "match": "\\b(?:perform|exhibit|include|satisfy|verify|assert|assume|require|allocate|bind|connect|frame|language|locale)\\b",
          "name": "keyword.other.sysml"
        },
        {
          "match": "\\b(?:action|actor|alias|allocation|analysis|attribute|binding|calc|case|comment|concern|connection|constraint|def|dependency|doc|enum|event|flow|interface|item|message|metadata|objective|occurrence|package|part|port|rendering|rep|requirement|snapshot|stakeholder|state|subject|succession|timeslice|transition|use|verification|view|viewpoint)\\b",
          "name": "storage.type.sysml"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.decorator.sysml"
            },
            "2": {
              "name": "entity.name.function.decorator.sysml"
            }
          },
          "comment": "Metadata on an element, as a decorator on a Python function: #refinement.",
          "match": "([#@])((?:[A-Za-z_][A-Za-z0-9_]*|'(?:[^'\\\\\\r\\n]|\\\\.)*'))"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "comment": "A name in single quotes, which may hold spaces: part 'flight controller'. A name, not a string: it keeps the text's colour.",
          "match": "'(?:[^'\\\\\\r\\n]|\\\\.)*'",
          "name": "meta.name.quoted.sysml"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b|\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b",
          "name": "constant.numeric.sysml"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": ":>>|::>|:>|::|->|=>|:=|\\.\\.|===|!==|==|!=|<=|>=|\\?\\?|~",
          "name": "keyword.operator.sysml"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.sysml",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.sysml"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.sysml"
}
